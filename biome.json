{
    "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/dist/**",
            "!**/node_modules/**",
            "!**/src/gen/**",
            "!**/templates/**",
            "!**/package.json",
            "!**/cli/src/templates.ts",
            "!**/out/**",
            "!**/integration-test/**"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "json": {
        "formatter": {}
    },
    "linter": {
        "enabled": false
    }
}
